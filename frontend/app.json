{
  "expo": {
    "name": "MedicPal",
    "slug": "medicpal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medicpal",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.medicpalhealth.k7ztqx",
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph medicine labels for reminders.",
        "NSPhotoLibraryUsageDescription": "Choose health documents for your private vault.",
        "NSLocationWhenInUseUsageDescription": "Share your location during a travel emergency"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E5F5FA"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.medicpalhealth.k7ztqx",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES"
        ,"ACCESS_COARSE_LOCATION"
        ,"ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your location during a travel emergency"
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5F5FA"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}